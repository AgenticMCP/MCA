# Copy to .env (same dir) or the repo root. Loaded automatically; env vars win.

# --- LLM provider ---
# Choices: deepseek (default) | openai | gemini | anthropic | minimax | qwen |
#          glm | kimi | grok | xiaomi | custom
AGENTICMCPE_LLM_PROVIDER=deepseek

# Put your key in the var(s) matching the active provider:
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=          # gemini (or GOOGLE_API_KEY)
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# DASHSCOPE_API_KEY=       # qwen (or QWEN_API_KEY)
# ZHIPUAI_API_KEY=         # glm (or GLM_API_KEY)
# MOONSHOT_API_KEY=        # kimi (or KIMI_API_KEY)
# XAI_API_KEY=             # grok (or GROK_API_KEY)
# XIAOMI_API_KEY=          # xiaomi MiMo (or MIMO_API_KEY)

# Optional per-run overrides (apply to whichever provider is active):
# AGENTICMCPE_LLM_MODEL=deepseek-chat
# AGENTICMCPE_LLM_BASE_URL=https://api.deepseek.com
# AGENTICMCPE_LLM_TEMPERATURE=0.0
# AGENTICMCPE_LLM_MAX_TOKENS=4096
# AGENTICMCPE_LLM_TIMEOUT=240                     # seconds per request
# AGENTICMCPE_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   # provider-specific toggles

# Self-define template — point at any OpenAI-compatible endpoint:
# AGENTICMCPE_LLM_PROVIDER=custom
# AGENTICMCPE_LLM_BASE_URL=https://your-host/v1   # required for custom
# AGENTICMCPE_LLM_MODEL=your-model-id             # required for custom
# AGENTICMCPE_LLM_API_KEY=                        # custom key (or CUSTOM_API_KEY)

# --- playwright-mcp server ---
# No token or secret: the server runs from this checkout with `node cli.js`.
# AGENTICMCPE_PW_CMD=npx -y @playwright/mcp@0.0.78   # pin the npm package instead
# AGENTICMCPE_PW_HEADLESS=1                          # 0 to watch the browser
# AGENTICMCPE_PW_ISOLATED=1                          # in-memory browser profile
# AGENTICMCPE_PW_BROWSER=chrome                      # chrome|firefox|webkit|msedge
# AGENTICMCPE_PW_TIMEOUT_ACTION=15000                # ms; heavy SPAs need > the 5s upstream default

# --- Misc ---
# AGENTICMCPE_RUNS_DIR=/abs/path/to/runs
# AGENTICMCPE_KB_PATH=/abs/path/to/knowledge_base.json
# AGENTICMCPE_DISABLE_RAG=1
